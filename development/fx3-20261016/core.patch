+/* FX3 CPU map. No ROM replication: the GSU masks the low-bank address.
+ * Keeping ROM immutable preserves cartridge bytes above 2 MiB. */
+static void Fx3ROMMap(void)
+{
+   for (unsigned bank = 0; bank < 256; bank++)
+      for (unsigned page = 0; page < 16; page++)
+      {
+         unsigned i = bank * 16 + page;
+         uint8 *ptr = (uint8 *) MAP_NONE;
+         int ram = 0, rom = 0;
+         Memory.MemorySpeed[i] = SLOW_ONE_CYCLE;
+         if ((bank & 0x7f) < 0x40)
+         {
+            if (page < 2) { ptr = Memory.RAM; ram = 1; }
+            else if (page == 2 || page == 7) ptr = (uint8 *) MAP_PPU;
+            else if (page == 4 || page == 5) ptr = (uint8 *) MAP_CPU;
+            else if (page >= 8)
+            { ptr = Memory.ROM + (((bank & 0x3f) << 15) % Memory.CalculatedSize) - 0x8000; rom = 1; }
+            if (page == 2 || page == 3) Memory.MemorySpeed[i] = ONE_CYCLE;
+         }
+         else if ((bank >= 0x40 && bank <= 0x6f) || bank >= 0xc0)
+         { ptr = Memory.ROM + (((bank & 0x3f) << 16) % Memory.CalculatedSize); rom = 1; }
+         else if (bank == 0x70 || bank == 0x71)
+         { ptr = SRAM + ((bank - 0x70) << 16); ram = 1; }
+         else if (bank == 0x7e || bank == 0x7f)
+         { ptr = Memory.RAM + ((bank - 0x7e) << 16); ram = 1; }
+         Memory.Map[i] = ptr;
+         Memory.BlockIsRAM[i] = ram;
+         Memory.BlockIsROM[i] = rom;
+      }
+   WriteProtectROM();
+}
