 /* 70 - merge - R7 as upper byte, R8 as lower byte (used for texture-mapping) */
+/* FX3 MERGE command port: planar renderer already performs commands 0..2.
+ * Commands 3..5 clear nine tile rows each: 18 visible tiles, pitch 20.
+ * Colour 0x81 sets planes 0 and 7. Generate it rather than storing a bitmap. */
+static void fx3_command(void)
+{
+   unsigned command = USEX16(R0);
+   if (command >= 3 && command <= 5)
+   {
+      unsigned first = (command - 3) * 9;
+      for (unsigned row = first; row < first + 9; row++)
+         for (unsigned col = 0; col < 18; col++)
+         {
+            uint8 *tile = GSU.pvRam + 0x10000 + (row * 20 + col) * 64;
+            memset(tile, 0, 64);
+            for (unsigned y = 0; y < 8; y++)
+            { tile[y * 2] = 0xff; tile[49 + y * 2] = 0xff; }
+         }
+   }
+}
